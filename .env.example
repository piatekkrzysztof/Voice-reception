PORT=4173
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:4173
PILOT_MODE=false

# Brak DATABASE_URL oznacza lokalne SQLite. Wdrożenie używa PostgreSQL.
DATABASE_URL=
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Bezpieczna konsola administratora
VOICE_SESSION_HOURS=8
VOICE_LOGIN_MAX_ATTEMPTS=5
VOICE_LOGIN_WINDOW_MINUTES=15
# Wymagany tylko do pierwszej konfiguracji wykonywanej przez publiczny adres.
# Lokalnie (127.0.0.1) pierwsze konto można utworzyć bez tokenu.
VOICE_SETUP_TOKEN=

# Operacje. Lokalnie retencja jest wyłączona, aby nie zmieniać danych deweloperskich.
HTTP_MAX_INFLIGHT=25
HTTP_REQUEST_TIMEOUT_MS=15000
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_BEARER_TOKEN=
ALERT_COOLDOWN_MINUTES=10
DATA_RETENTION_ENABLED=false
DATA_RETENTION_INTERVAL_MINUTES=360
DATA_RETENTION_CALLS_DAYS=30
DATA_RETENTION_BOOKINGS_DAYS=365
DATA_RETENTION_EVENTS_DAYS=90
DATA_RETENTION_HOLDS_DAYS=7

# Firma i lokalny Booking Service
VOICE_DATABASE_PATH=./data/voice.sqlite
VOICE_TENANT_ID=atelier-polnoc
VOICE_BUSINESS_NAME=Atelier Północ
VOICE_LOCALE=pl-PL
VOICE_TIMEZONE=Europe/Warsaw
VOICE_HOLD_MINUTES=5
VOICE_SLOT_SECRET=change-me-before-public-deployment
VOICE_WEBHOOK_SECRET=
VOICE_HUMAN_TRANSFER_NUMBER=

# Tryb lokalny działa bez kont zewnętrznych.
VOICE_PROVIDER=local
CALENDAR_PROVIDER=local

# Vapi
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_SERVER_CREDENTIAL_ID=
VAPI_API_URL=https://api.vapi.ai
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4.1-mini
VAPI_VOICE_PROVIDER=
VAPI_VOICE_ID=

# Cal.com API v2
CALCOM_API_KEY=
CALCOM_API_URL=https://api.cal.com
CALCOM_TIMEOUT_MS=8000
CALCOM_DEFAULT_ATTENDEE_EMAIL=
CALCOM_EVENT_TYPE_KOLORYZACJA=
CALCOM_EVENT_TYPE_STRZYZENIE=
CALCOM_EVENT_TYPE_KONSULTACJA=
CALCOM_RESERVE_SLOTS=false
