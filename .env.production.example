PUBLIC_DOMAIN=voice.example.com

# Wygeneruj osobne wartości, np. -join (1..32 | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
POSTGRES_PASSWORD=replace-with-a-long-random-password
VOICE_SLOT_SECRET=replace-with-at-least-32-random-characters
VOICE_SETUP_TOKEN=replace-with-at-least-32-random-characters

VOICE_TENANT_ID=atelier-polnoc
VOICE_BUSINESS_NAME=Atelier Północ
VOICE_LOCALE=pl-PL
VOICE_TIMEZONE=Europe/Warsaw
VOICE_HOLD_MINUTES=5
VOICE_SESSION_HOURS=8

# Kontrolowane demo może pozostać lokalne. Przed prawdziwym pilotem ustaw false i uzupełnij integracje.
ALLOW_LOCAL_PROVIDERS=true
VOICE_PROVIDER=local
CALENDAR_PROVIDER=local

VOICE_WEBHOOK_SECRET=
VOICE_HUMAN_TRANSFER_NUMBER=
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_SERVER_CREDENTIAL_ID=
CALCOM_API_KEY=
CALCOM_DEFAULT_ATTENDEE_EMAIL=
CALCOM_EVENT_TYPE_KOLORYZACJA=
CALCOM_EVENT_TYPE_STRZYZENIE=
CALCOM_EVENT_TYPE_KONSULTACJA=
